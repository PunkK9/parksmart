PORT=5000
MONGO_URI=paste_your_mongodb_connection_string_here
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Gmail account that SENDS the verification emails.
# EMAIL_PASS must be a Google "App Password" (16 characters), not your normal Gmail password.
# If these two are left empty, the verification link is printed in this terminal instead.
EMAIL_USER=yourgmail@gmail.com
EMAIL_PASS=your_16_char_app_password
